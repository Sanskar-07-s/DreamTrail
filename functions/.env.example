# Cloud Functions Environment Configuration (Documentation Template)
# In production, use Firebase / Google Cloud Secret Manager (defineSecret in v2)

# AI Provider Selection: 'mock' | 'gemini' | 'openai'
AI_PROVIDER=mock

# Server-Side Privileged API Keys (Managed via Secret Manager in production)
OPENAI_API_KEY=sk-demo-openai-key-do-not-expose-to-client
GEMINI_API_KEY=AIzaSyDemoGeminiKey-do-not-expose-to-client

# Server Region
FUNCTIONS_REGION=us-central1
