# Client Environment Variables (Frontend Safe Only)
# Do NOT place secret API keys (OpenAI, Gemini, Firebase Admin) in this file!

VITE_FIREBASE_API_KEY=AIzaSyDemoKeyForDreamTrailLocalDev
VITE_FIREBASE_AUTH_DOMAIN=dreamtrail-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dreamtrail-prod
VITE_FIREBASE_STORAGE_BUCKET=dreamtrail-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# MapTiler Public Basemap API Key
VITE_MAPTILER_API_KEY=get_your_maptiler_key_at_maptiler_com

# Optional Emulator Flag (set to 'true' for local testing against Firebase Emulator Suite)
VITE_USE_FIREBASE_EMULATOR=false
